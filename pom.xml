<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>pt.uc00605_projeto_final_cliente</groupId>
	<artifactId>projeto_final_cliente</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description>Cadastro simples de Clientes para o Trabalho Final da UC00605</description>
	<url/>
	
	<properties>
		<java.version>21</java.version>
		<spring-boot.version>3.3.0</spring-boot.version>
	</properties>

	<!-- Declaração das Dependências utilizadas pelo programa -->
	<dependencies>

		<dependency> <!-- Para fazer o starter do programa na web -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
		
		<dependency> <!-- Para usar serviços JPA -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency> 
		
		<dependency> <!-- Para uso de serviços devtools -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency> 
		
		<dependency> <!-- Para uso do mysql caso precise -->
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency> <!-- Para uso do serviço lombrok -->
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency> <!-- Para testes -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies> <!-- fim da declaração das dependências -->

	<build>
		<plugins>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>				
			</plugin>
			
		</plugins>
	</build>

</project>
